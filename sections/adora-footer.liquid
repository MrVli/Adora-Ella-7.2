{%- liquid
  assign footer_bg = section.settings.footer_background_color
  case section.settings.footer_background_style
    when 'primary'
      assign footer_bg = 'var(--adora-primary, #805394)'
    when 'cream'
      assign footer_bg = 'var(--adora-cream, #fff8ef)'
    when 'mist'
      assign footer_bg = 'var(--adora-mist, #fbf3ff)'
    when 'lilac_gradient'
      assign footer_bg = 'radial-gradient(circle at 18% 0%, rgba(232, 175, 254, 0.22), transparent 34%), linear-gradient(180deg, #805394 0%, #3a2351 100%)'
  endcase

  assign hero_bg = section.settings.hero_background_color
  case section.settings.hero_background_style
    when 'glass'
      assign hero_bg = 'rgba(255, 255, 255, 0.12)'
    when 'primary'
      assign hero_bg = 'rgba(58, 35, 81, 0.26)'
    when 'lilac_gradient'
      assign hero_bg = 'radial-gradient(circle at 18% 12%, rgba(232, 175, 254, 0.22), transparent 38%), rgba(255, 255, 255, 0.10)'
  endcase
-%}

<footer class="adora-footer adora-footer--hero-{{ section.settings.hero_layout }} adora-footer--nav-{{ section.settings.navigation_layout_desktop }} adora-footer--mobile-nav-{{ section.settings.navigation_layout_mobile }} adora-footer--trust-mobile-{{ section.settings.trust_layout_mobile }} adora-footer--bottom-{{ section.settings.bottom_bar_layout }}{% if section.settings.enable_glassmorphism %} adora-footer--glass{% endif %}{% if section.settings.enable_soft_shadow %} adora-footer--shadow{% endif %}{% if section.settings.enable_hover_lift %} adora-footer--hover{% endif %}"
  style="--adora-footer-bg: {{ footer_bg }}; --adora-footer-text: {{ section.settings.footer_text_color }}; --adora-footer-muted: {{ section.settings.footer_muted_text_color }}; --adora-footer-accent: {{ section.settings.footer_accent_color }}; --adora-footer-border: {{ section.settings.footer_border_color }}; --adora-footer-logo: {{ section.settings.footer_logo_color }}; --adora-footer-max: {{ section.settings.footer_max_width }}px; --adora-footer-pad-d: {{ section.settings.footer_padding_desktop }}px; --adora-footer-pad-m: {{ section.settings.footer_padding_mobile }}px; --adora-footer-gap: {{ section.settings.footer_section_gap }}px; --adora-footer-hero-bg: {{ hero_bg }}; --adora-footer-hero-text: {{ section.settings.hero_text_color }}; --adora-footer-hero-accent: {{ section.settings.hero_accent_color }}; --adora-footer-hero-radius: {{ section.settings.hero_border_radius }}px; --adora-footer-nav-heading: {{ section.settings.nav_heading_color }}; --adora-footer-nav-link: {{ section.settings.nav_link_color }}; --adora-footer-nav-hover: {{ section.settings.nav_link_hover_color }}; --adora-footer-trust-text: {{ section.settings.trust_text_color }}; --adora-footer-trust-bg: {{ section.settings.trust_background_color }}; --adora-footer-trust-border: {{ section.settings.trust_border_color }}; --adora-footer-bottom-text: {{ section.settings.bottom_text_color }}; --adora-footer-bottom-border: {{ section.settings.bottom_border_color }};">
  <div class="adora-footer__inner">
    {%- if section.settings.show_big_logo and section.settings.footer_logo_text != blank -%}
      <div class="adora-footer__brandmark" aria-label="{{ section.settings.footer_logo_text | escape }}">
        {{ section.settings.footer_logo_text | escape }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_footer_hero -%}
      <div class="adora-footer__hero">
        {%- if section.settings.show_hero_glow_veil -%}<span class="adora-footer__hero-glow" aria-hidden="true"></span>{%- endif -%}
        <div class="adora-footer__hero-copy">
          {%- if section.settings.hero_eyebrow != blank -%}<p class="adora-footer__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.hero_headline != blank -%}<h2 class="adora-footer__hero-heading">{{ section.settings.hero_headline | escape }}</h2>{%- endif -%}
          {%- if section.settings.hero_text != blank -%}<div class="adora-footer__hero-text">{{ section.settings.hero_text }}</div>{%- endif -%}
          <div class="adora-footer__hero-actions">
            {%- render 'adora-button', label: section.settings.hero_primary_button_label, link: section.settings.hero_primary_button_link, style: 'primary', class: 'adora-footer__button', aria_label: section.settings.hero_primary_button_label -%}
            {%- render 'adora-button', label: section.settings.hero_secondary_button_label, link: section.settings.hero_secondary_button_link, style: 'glass', class: 'adora-footer__button', aria_label: section.settings.hero_secondary_button_label -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="adora-footer__middle">
      {%- if section.settings.show_navigation -%}
        <nav class="adora-footer__nav" aria-label="Footer navigation">
          {%- for block in section.blocks -%}
            {%- if block.type == 'footer_column' -%}
              <details class="adora-footer__nav-column" {% unless section.settings.enable_mobile_accordion %}open{% endunless %} {{ block.shopify_attributes }}>
                <summary class="adora-footer__nav-heading">
                  <span>{{ block.settings.column_heading | default: 'ADORA' | escape }}</span>
                  <span class="adora-footer__accordion-icon" aria-hidden="true">+</span>
                </summary>
                <div class="adora-footer__nav-links">
                  {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                    {%- for link in block.settings.menu.links -%}
                      <a href="{{ link.url }}" class="adora-footer__nav-link">{{ link.title | escape }}</a>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..5) -%}
                      {%- liquid
                        assign label_key = 'custom_link_' | append: i | append: '_label'
                        assign url_key = 'custom_link_' | append: i | append: '_url'
                        assign item_label = block.settings[label_key]
                        assign item_url = block.settings[url_key] | default: '#'
                      -%}
                      {%- if item_label != blank -%}<a href="{{ item_url }}" class="adora-footer__nav-link">{{ item_label | escape }}</a>{%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="adora-footer__newsletter" style="--adora-footer-newsletter-bg: {{ section.settings.newsletter_card_background }};">
          {%- if section.settings.newsletter_heading != blank -%}<h3 class="adora-footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h3>{%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}<div class="adora-footer__newsletter-text">{{ section.settings.newsletter_text }}</div>{%- endif -%}
          {%- form 'customer', id: 'AdoraFooterNewsletter', class: 'adora-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="adora-footer__visually-hidden" for="AdoraFooterEmail-{{ section.id }}">{{ section.settings.newsletter_placeholder | escape }}</label>
            <div class="adora-footer__field">
              <input id="AdoraFooterEmail-{{ section.id }}" class="adora-footer__email-input" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.newsletter_placeholder | escape }}" autocorrect="off" autocapitalize="off" autocomplete="email" required>
              <button class="adora-footer__submit" type="submit">{{ section.settings.newsletter_button_label | escape }}</button>
            </div>
            {%- if form.posted_successfully? -%}<p class="adora-footer__form-message" role="status">{{ section.settings.newsletter_success_message | escape }}</p>{%- endif -%}
            {%- if form.errors -%}<p class="adora-footer__form-message adora-footer__form-message--error" role="alert">{{ section.settings.newsletter_error_message | escape }}</p>{%- endif -%}
          {%- endform -%}
          {%- if section.settings.newsletter_microcopy != blank -%}<p class="adora-footer__microcopy">{{ section.settings.newsletter_microcopy | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_trust_row -%}
      <div class="adora-footer__trust" role="list" aria-label="ADORA trust signals">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' and block.settings.trust_text != blank -%}
            {%- if block.settings.trust_link != blank -%}
              <a class="adora-footer__trust-item" role="listitem" href="{{ block.settings.trust_link }}" {{ block.shopify_attributes }}><span>{{ block.settings.trust_text | escape }}</span></a>
            {%- else -%}
              <div class="adora-footer__trust-item" role="listitem" {{ block.shopify_attributes }}><span>{{ block.settings.trust_text | escape }}</span></div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_bottom_bar -%}
      <div class="adora-footer__bottom">
        <div class="adora-footer__copyright">{{ section.settings.copyright_text | escape }}</div>
        {%- if section.settings.bottom_claim != blank -%}<div class="adora-footer__claim">{{ section.settings.bottom_claim | escape }}</div>{%- endif -%}
        <div class="adora-footer__bottom-links">
          {%- if section.settings.legal_menu != blank and section.settings.legal_menu.links.size > 0 -%}
            {%- for link in section.settings.legal_menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
          {%- endif -%}
          {%- if section.settings.show_social_links -%}
            {%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" aria-label="ADORA auf Instagram">Instagram</a>{%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}<a href="{{ section.settings.tiktok_url }}" aria-label="ADORA auf TikTok">TikTok</a>{%- endif -%}
            {%- if section.settings.pinterest_url != blank -%}<a href="{{ section.settings.pinterest_url }}" aria-label="ADORA auf Pinterest">Pinterest</a>{%- endif -%}
          {%- endif -%}
        </div>
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types != blank -%}
          <div class="adora-footer__payments" aria-label="Payment methods">
            {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'adora-footer__payment-icon' }}{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "ADORA Footer",
  "tag": "section",
  "class": "section-adora-footer",
  "max_blocks": 14,
  "settings": [
    { "type": "header", "content": "Global" },
    { "type": "select", "id": "footer_background_style", "label": "Footer background style", "default": "primary", "options": [{ "value": "primary", "label": "ADORA purple" }, { "value": "cream", "label": "Cream" }, { "value": "mist", "label": "Mist" }, { "value": "lilac_gradient", "label": "Purple gradient" }, { "value": "custom", "label": "Custom" }] },
    { "type": "color_background", "id": "footer_background_color", "label": "Footer background color", "default": "#805394" },
    { "type": "color", "id": "footer_text_color", "label": "Footer text color", "default": "#fff8ef" },
    { "type": "color", "id": "footer_muted_text_color", "label": "Muted text color", "default": "#f7f1ec" },
    { "type": "color", "id": "footer_accent_color", "label": "Accent color", "default": "#e8affe" },
    { "type": "color", "id": "footer_border_color", "label": "Border color", "default": "rgba(255, 248, 239, 0.24)" },
    { "type": "checkbox", "id": "show_big_logo", "label": "Show big ADORA logo", "default": true },
    { "type": "text", "id": "footer_logo_text", "label": "Big logo text", "default": "ADORA" },
    { "type": "color", "id": "footer_logo_color", "label": "Big logo color", "default": "#fff8ef" },
    { "type": "range", "id": "footer_max_width", "label": "Max width", "min": 1040, "max": 1680, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "footer_padding_desktop", "label": "Padding desktop", "min": 48, "max": 180, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "footer_padding_mobile", "label": "Padding mobile", "min": 36, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "footer_section_gap", "label": "Section gap", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 34 },
    { "type": "checkbox", "id": "enable_glassmorphism", "label": "Enable glassmorphism", "default": true },
    { "type": "checkbox", "id": "enable_soft_shadow", "label": "Enable soft shadow", "default": false },
    { "type": "checkbox", "id": "enable_hover_lift", "label": "Enable hover lift", "default": true },
    { "type": "checkbox", "id": "enable_reduced_motion_support", "label": "Respect reduced motion", "default": true },

    { "type": "header", "content": "Signature footer hero" },
    { "type": "checkbox", "id": "show_footer_hero", "label": "Show footer hero", "default": true },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "ADORA RITUALS" },
    { "type": "text", "id": "hero_headline", "label": "Hero headline", "default": "Dein nächster Hautmoment beginnt hier." },
    { "type": "richtext", "id": "hero_text", "label": "Hero text", "default": "<p>Entdecke kuratierte Skincare-Rituale, Essentials und Sets für weiche, gepflegte und sichtbar strahlende Haut.</p>" },
    { "type": "text", "id": "hero_primary_button_label", "label": "Primary button label", "default": "Ritual entdecken" },
    { "type": "url", "id": "hero_primary_button_link", "label": "Primary button link" },
    { "type": "text", "id": "hero_secondary_button_label", "label": "Secondary button label", "default": "Alle Produkte ansehen" },
    { "type": "url", "id": "hero_secondary_button_link", "label": "Secondary button link" },
    { "type": "select", "id": "hero_layout", "label": "Hero layout", "default": "centered", "options": [{ "value": "text_left", "label": "Text left" }, { "value": "centered", "label": "Centered" }] },
    { "type": "select", "id": "hero_background_style", "label": "Hero background style", "default": "glass", "options": [{ "value": "glass", "label": "Glass" }, { "value": "primary", "label": "Deep purple" }, { "value": "lilac_gradient", "label": "Lilac glow" }, { "value": "custom", "label": "Custom" }] },
    { "type": "color_background", "id": "hero_background_color", "label": "Hero background color", "default": "rgba(255, 255, 255, 0.12)" },
    { "type": "color", "id": "hero_text_color", "label": "Hero text color", "default": "#fff8ef" },
    { "type": "color", "id": "hero_accent_color", "label": "Hero accent color", "default": "#e8affe" },
    { "type": "range", "id": "hero_border_radius", "label": "Hero border radius", "min": 24, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "show_hero_glow_veil", "label": "Show hero glow veil", "default": true },

    { "type": "header", "content": "Navigation" },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation", "default": true },
    { "type": "select", "id": "navigation_layout_desktop", "label": "Navigation desktop layout", "default": "four_columns", "options": [{ "value": "four_columns", "label": "Four columns" }, { "value": "three_columns", "label": "Three columns" }, { "value": "editorial_grid", "label": "Editorial grid" }] },
    { "type": "select", "id": "navigation_layout_mobile", "label": "Navigation mobile layout", "default": "accordion", "options": [{ "value": "accordion", "label": "Accordion" }, { "value": "stacked", "label": "Stacked" }] },
    { "type": "color", "id": "nav_heading_color", "label": "Nav heading color", "default": "#fff8ef" },
    { "type": "color", "id": "nav_link_color", "label": "Nav link color", "default": "#f7f1ec" },
    { "type": "color", "id": "nav_link_hover_color", "label": "Nav link hover color", "default": "#e8affe" },
    { "type": "checkbox", "id": "enable_mobile_accordion", "label": "Enable mobile accordion", "default": true },

    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Der ADORA Ritual Letter" },
    { "type": "richtext", "id": "newsletter_text", "label": "Newsletter text", "default": "<p>Erhalte neue Rituale, Launches und Pflege-Inspirationen — ruhig, kuratiert und ohne Spam.</p>" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Email placeholder", "default": "Deine E-Mail-Adresse" },
    { "type": "text", "id": "newsletter_button_label", "label": "Button label", "default": "Eintragen" },
    { "type": "text", "id": "newsletter_microcopy", "label": "Microcopy", "default": "Neue Launches · Ritual Guides · Exklusive Drops" },
    { "type": "color_background", "id": "newsletter_card_background", "label": "Newsletter card background", "default": "rgba(255, 255, 255, 0.12)" },
    { "type": "text", "id": "newsletter_success_message", "label": "Success message", "default": "Danke. Dein Ritual Letter ist aktiviert." },
    { "type": "text", "id": "newsletter_error_message", "label": "Error message", "default": "Bitte prüfe deine E-Mail-Adresse." },

    { "type": "header", "content": "Trust row" },
    { "type": "checkbox", "id": "show_trust_row", "label": "Show trust row", "default": true },
    { "type": "select", "id": "trust_layout_desktop", "label": "Trust desktop layout", "default": "row", "options": [{ "value": "row", "label": "Row" }, { "value": "grid", "label": "Grid" }] },
    { "type": "select", "id": "trust_layout_mobile", "label": "Trust mobile layout", "default": "wrap", "options": [{ "value": "wrap", "label": "Wrap" }, { "value": "scroll", "label": "Scroll" }, { "value": "stacked", "label": "Stacked" }] },
    { "type": "color", "id": "trust_text_color", "label": "Trust text color", "default": "#fff8ef" },
    { "type": "color_background", "id": "trust_background_color", "label": "Trust background", "default": "rgba(255, 255, 255, 0.12)" },
    { "type": "color", "id": "trust_border_color", "label": "Trust border", "default": "rgba(255, 248, 239, 0.22)" },

    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_bottom_bar", "label": "Show bottom bar", "default": true },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "© 2026 ADORA" },
    { "type": "text", "id": "bottom_claim", "label": "Bottom claim", "default": "Soft lavender skincare rituals for modern skin." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": false },
    { "type": "checkbox", "id": "show_social_links", "label": "Show social links", "default": true },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu" },
    { "type": "select", "id": "bottom_bar_layout", "label": "Bottom layout", "default": "spread", "options": [{ "value": "spread", "label": "Spread" }, { "value": "centered", "label": "Centered" }, { "value": "stacked", "label": "Stacked" }] },
    { "type": "color", "id": "bottom_text_color", "label": "Bottom text color", "default": "#f7f1ec" },
    { "type": "color", "id": "bottom_border_color", "label": "Bottom border color", "default": "rgba(255, 248, 239, 0.22)" }
  ],
  "blocks": [
    {
      "type": "footer_column",
      "name": "Footer column",
      "settings": [
        { "type": "text", "id": "column_heading", "label": "Column heading", "default": "Shop ADORA" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "custom_link_1_label", "label": "Custom link 1 label", "default": "Glass Skin Ritual" },
        { "type": "url", "id": "custom_link_1_url", "label": "Custom link 1 URL" },
        { "type": "text", "id": "custom_link_2_label", "label": "Custom link 2 label", "default": "Ritual Sets" },
        { "type": "url", "id": "custom_link_2_url", "label": "Custom link 2 URL" },
        { "type": "text", "id": "custom_link_3_label", "label": "Custom link 3 label", "default": "Single Essentials" },
        { "type": "url", "id": "custom_link_3_url", "label": "Custom link 3 URL" },
        { "type": "text", "id": "custom_link_4_label", "label": "Custom link 4 label", "default": "Body Rituals" },
        { "type": "url", "id": "custom_link_4_url", "label": "Custom link 4 URL" },
        { "type": "text", "id": "custom_link_5_label", "label": "Custom link 5 label", "default": "Gift Rituals" },
        { "type": "url", "id": "custom_link_5_url", "label": "Custom link 5 URL" }
      ]
    },
