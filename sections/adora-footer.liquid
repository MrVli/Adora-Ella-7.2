      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "trust_text", "label": "Trust text", "default": "Vegan" },
        { "type": "url", "id": "trust_link", "label": "Trust link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ADORA Footer",
      "blocks": [
        { "type": "footer_column", "settings": { "column_heading": "Shop ADORA", "custom_link_1_label": "Glass Skin Ritual", "custom_link_2_label": "Ritual Sets", "custom_link_3_label": "Single Essentials", "custom_link_4_label": "Body Rituals", "custom_link_5_label": "Gift Rituals" } },
        { "type": "footer_column", "settings": { "column_heading": "Explore", "custom_link_1_label": "The ADORA Method", "custom_link_2_label": "Ingredients", "custom_link_3_label": "How to Use", "custom_link_4_label": "Reviews", "custom_link_5_label": "" } },
        { "type": "footer_column", "settings": { "column_heading": "Support", "custom_link_1_label": "Kontakt", "custom_link_2_label": "Versand", "custom_link_3_label": "Rückgabe", "custom_link_4_label": "FAQ", "custom_link_5_label": "" } },
        { "type": "footer_column", "settings": { "column_heading": "Legal", "custom_link_1_label": "Impressum", "custom_link_2_label": "Datenschutz", "custom_link_3_label": "AGB", "custom_link_4_label": "Widerruf", "custom_link_5_label": "" } },
        { "type": "trust_item", "settings": { "trust_text": "Vegan" } },
        { "type": "trust_item", "settings": { "trust_text": "Made in Europe" } },
        { "type": "trust_item", "settings": { "trust_text": "Premium Ritual Sets" } },
        { "type": "trust_item", "settings": { "trust_text": "Secure Checkout" } }
      ]
    }
  ]
}
{% endschema %}
