{%- liquid
  assign morning = product.metafields.adora.how_to_use_morning.value | default: section.settings.morning_text
  assign evening = product.metafields.adora.how_to_use_evening.value | default: section.settings.evening_text
  assign note = product.metafields.adora.ritual_note.value | default: section.settings.note
-%}

<section class="adora-pdp-howto" style="--adora-pdp-accent: {{ section.settings.accent_color }}; --adora-pdp-text: {{ section.settings.text_color }}; --adora-pdp-bg: {{ section.settings.background_color }};">
  <div class="adora-pdp-howto__inner">
    <div class="adora-pdp-howto__header">
      {%- if section.settings.eyebrow != blank -%}<p>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.headline | escape }}</h2>
      {%- if section.settings.subheadline != blank -%}<div>{{ section.settings.subheadline }}</div>{%- endif -%}
    </div>
    <div class="adora-pdp-howto__grid">
      <article class="adora-pdp-howto__card"><span>01</span><h3>{{ section.settings.morning_title | escape }}</h3><p>{{ morning | escape }}</p></article>
      <article class="adora-pdp-howto__card"><span>02</span><h3>{{ section.settings.evening_title | escape }}</h3><p>{{ evening | escape }}</p></article>
    </div>
    {%- if note != blank -%}<div class="adora-pdp-howto__note">{{ note | escape }}</div>{%- endif -%}
  </div>
</section>

<style>
  .adora-pdp-howto { background: var(--adora-pdp-bg); color: var(--adora-pdp-text); padding: clamp(46px, 7vw, 104px) 16px; font-family: var(--font-body, Inter, sans-serif); }
  .adora-pdp-howto__inner { width: min(100%, 1240px); margin: 0 auto; }
  .adora-pdp-howto__header { max-width: 760px; margin-bottom: 24px; }
  .adora-pdp-howto__header p { margin: 0 0 10px; color: var(--adora-pdp-accent); font: 850 12px/1 var(--font-display, Inter, sans-serif); letter-spacing: .14em; text-transform: uppercase; }
  .adora-pdp-howto__header h2 { margin: 0; font: 850 clamp(30px, 5vw, 56px)/.96 var(--font-display, Inter, sans-serif); letter-spacing: -.045em; }
  .adora-pdp-howto__header div { margin-top: 14px; max-width: 620px; color: rgba(36,24,44,.68); line-height: 1.55; }
  .adora-pdp-howto__grid { display: grid; gap: 14px; }
  .adora-pdp-howto__card, .adora-pdp-howto__note { border: 1px solid rgba(128,83,148,.15); border-radius: 30px; background: rgba(255,255,255,.78); box-shadow: 0 18px 60px rgba(58,35,81,.07); padding: clamp(22px, 4vw, 36px); }
  .adora-pdp-howto__card span { color: var(--adora-pdp-accent); font: 900 13px/1 var(--font-display, Inter, sans-serif); }
  .adora-pdp-howto__card h3 { margin: 26px 0 10px; font: 850 clamp(22px, 3vw, 34px)/1 var(--font-display, Inter, sans-serif); letter-spacing: -.035em; }
  .adora-pdp-howto__card p, .adora-pdp-howto__note { color: rgba(36,24,44,.7); line-height: 1.58; }
  .adora-pdp-howto__note { margin-top: 14px; }
  @media (min-width: 800px) { .adora-pdp-howto__grid { grid-template-columns: 1fr 1fr; } }
</style>

{% schema %}
{
  "name": "ADORA PDP How To Use",
  "tag": "section",
  "class": "section-adora-pdp-how-to-use",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW TO USE" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "So wird es Teil deines ADORA Rituals." },
    { "type": "richtext", "id": "subheadline", "label": "Subheadline", "default": "<p>Kurze Anwendungshinweise, die Orientierung geben und die Routine einfach halten.</p>" },
    { "type": "text", "id": "morning_title", "label": "Morning title", "default": "Morgens" },
    { "type": "textarea", "id": "morning_text", "label": "Morning text", "default": "Als passenden Schritt in dein morgendliches ADORA Ritual integrieren. Sanft auftragen und mit dem nächsten Ritual-Schritt fortfahren." },
    { "type": "text", "id": "evening_title", "label": "Evening title", "default": "Abends" },
    { "type": "textarea", "id": "evening_text", "label": "Evening text", "default": "Abends verwenden, wenn deine Haut und dein Alltag einen ruhigeren Pflege-Moment brauchen." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Bei reaktiver Haut zuerst testen und langsam in die Routine einführen." },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#24182c" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#805394" }
  ],
  "presets": [ { "name": "ADORA PDP How To Use" } ]
}
{% endschema %}
