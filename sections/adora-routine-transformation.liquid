{%- liquid
  assign section_bg = section.settings.background_color

  case section.settings.background_style
    when 'cream'
      assign section_bg = 'var(--adora-cream)'
    when 'mist'
      assign section_bg = 'var(--adora-mist)'
    when 'lilac_gradient'
      assign section_bg = 'radial-gradient(circle at 15% 12%, rgba(232, 175, 254, 0.44), transparent 34%), linear-gradient(135deg, #fff8ef 0%, #fbf3ff 50%, #f4d8ff 100%)'
  endcase
-%}

<section
  class="adora-section adora-routine-transformation{% if section.settings.show_center_marker %} adora-routine-transformation--marker{% endif %}"
  style="
    --adora-routine-transformation-bg: {{ section_bg }};
    --adora-routine-transformation-before-bg: {{ section.settings.before_panel_background }};
    --adora-routine-transformation-after-bg: {{ section.settings.after_panel_background }};
    --adora-routine-transformation-text: {{ section.settings.text_color }};
    --adora-routine-transformation-accent: {{ section.settings.accent_color }};
    --adora-routine-transformation-padding-desktop: {{ section.settings.padding_desktop }}px;
    --adora-routine-transformation-padding-mobile: {{ section.settings.padding_mobile }}px;
  "
>
  <div class="adora-container adora-routine-transformation__container">
    <div class="adora-routine-transformation__header" data-adora-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="adora-eyebrow adora-routine-transformation__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.headline != blank -%}
        <h2 class="adora-heading adora-routine-transformation__headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheadline != blank -%}
        <div class="adora-richtext adora-subheading adora-routine-transformation__subheadline">{{ section.settings.subheadline }}</div>
      {%- endif -%}
    </div>

    <div class="adora-routine-transformation__panels" data-adora-reveal>
      <article class="adora-routine-transformation__panel adora-routine-transformation__panel--before">
        {%- if section.settings.before_image != blank -%}
          <div class="adora-routine-transformation__media">
            {{ section.settings.before_image | image_url: width: 1200 | image_tag: class: 'adora-routine-transformation__image', alt: section.settings.image_alt_before, loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 750px) 45vw, 100vw' }}
          </div>
        {%- endif -%}

        <div class="adora-routine-transformation__panel-content">
          {%- if section.settings.before_title != blank -%}
            <h3 class="adora-routine-transformation__panel-title">{{ section.settings.before_title | escape }}</h3>
          {%- endif -%}

          {%- assign before_items = section.blocks | where: 'type', 'before_item' -%}
          {%- if before_items.size > 0 -%}
            <ul class="adora-routine-transformation__list">
              {%- for block in before_items -%}
                {%- if block.settings.text != blank -%}
                  <li class="adora-routine-transformation__item" {{ block.shopify_attributes }}>
                    <span class="adora-routine-transformation__item-mark" aria-hidden="true"></span>
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </article>

      {%- if section.settings.show_center_marker -%}
        <div class="adora-routine-transformation__marker" aria-hidden="true">
          <span>Reset</span>
        </div>
      {%- endif -%}

      <article class="adora-routine-transformation__panel adora-routine-transformation__panel--after">
        {%- if section.settings.after_image != blank -%}
          <div class="adora-routine-transformation__media">
            {{ section.settings.after_image | image_url: width: 1200 | image_tag: class: 'adora-routine-transformation__image', alt: section.settings.image_alt_after, loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 750px) 45vw, 100vw' }}
          </div>
        {%- endif -%}

        <div class="adora-routine-transformation__panel-content">
          {%- if section.settings.after_title != blank -%}
            <h3 class="adora-routine-transformation__panel-title">{{ section.settings.after_title | escape }}</h3>
          {%- endif -%}

          {%- assign after_items = section.blocks | where: 'type', 'after_item' -%}
          {%- if after_items.size > 0 -%}
            <ul class="adora-routine-transformation__list">
              {%- for block in after_items -%}
                {%- if block.settings.text != blank -%}
                  <li class="adora-routine-transformation__item" {{ block.shopify_attributes }}>
                    <span class="adora-routine-transformation__item-mark" aria-hidden="true"></span>
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </article>
    </div>

    {%- if section.settings.show_cta -%}
      <div class="adora-routine-transformation__cta" data-adora-reveal>
        {% render 'adora-button', label: section.settings.button_label, link: section.settings.button_link, style: 'primary', class: 'adora-routine-transformation__button' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .adora-routine-transformation {
    padding-block: var(--adora-routine-transformation-padding-mobile);
    color: var(--adora-routine-transformation-text);
    background: var(--adora-routine-transformation-bg);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__container {
    display: grid;
    gap: 30px;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__header {
    max-width: 830px;
    margin-inline: auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__eyebrow {
    color: var(--adora-routine-transformation-accent);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__headline {
    max-width: 13ch;
    margin-inline: auto;
    color: var(--adora-routine-transformation-text);
    font-size: clamp(2.45rem, 10vw, 4.8rem);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__subheadline {
    max-width: 56ch;
    margin: 16px auto 0;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panels {
    position: relative;
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel {
    display: grid;
    gap: 18px;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(128, 83, 148, 0.16);
    border-radius: 30px;
    box-shadow: 0 22px 72px rgba(58, 35, 81, 0.08);
    backdrop-filter: blur(16px);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel--before {
    background: var(--adora-routine-transformation-before-bg);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel--after {
    background: var(--adora-routine-transformation-after-bg);
    border-color: rgba(128, 83, 148, 0.24);
    box-shadow: 0 26px 82px rgba(58, 35, 81, 0.11);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__media {
    min-height: 260px;
    overflow: hidden;
    border-radius: 28px;
    margin: 12px 12px 0;
    background: linear-gradient(135deg, rgba(255, 248, 239, 0.9), rgba(244, 216, 255, 0.62));
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel-content {
    display: grid;
    gap: 18px;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel-title {
    margin: 0;
    color: var(--adora-routine-transformation-text);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 7vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__list {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 11px;
    padding: 12px 14px;
    color: var(--adora-muted);
    font-size: 0.96rem;
    line-height: 1.35;
    background: rgba(255, 255, 255, 0.44);
    border: 1px solid rgba(128, 83, 148, 0.1);
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__item-mark {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(128, 83, 148, 0.42);
    box-shadow: 0 0 0 5px rgba(128, 83, 148, 0.08);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel--after .adora-routine-transformation__item {
    color: var(--adora-routine-transformation-text);
    background: rgba(255, 255, 255, 0.54);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__panel--after .adora-routine-transformation__item-mark {
    background: var(--adora-routine-transformation-accent);
    box-shadow: 0 0 0 5px rgba(232, 175, 254, 0.18);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__marker {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 82px;
    height: 82px;
    margin-block: -2px;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(128, 83, 148, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    box-shadow: 0 18px 54px rgba(58, 35, 81, 0.18);
    backdrop-filter: blur(16px);
  }

  #shopify-section-{{ section.id }} .adora-routine-transformation__cta {
    display: flex;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .adora-routine-transformation {
      padding-block: var(--adora-routine-transformation-padding-desktop);
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__container {
      gap: clamp(42px, 5vw, 76px);
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__panels {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      gap: clamp(18px, 2.4vw, 34px);
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__panel {
      border-radius: 36px;
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__media {
      min-height: 320px;
      border-radius: 30px;
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__image {
      min-height: 320px;
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__panel-content {
      padding: clamp(28px, 3vw, 44px);
    }

    #shopify-section-{{ section.id }} .adora-routine-transformation__marker {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      transform: translate(-50%, -50%);
      width: 96px;
      height: 96px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ADORA Routine Shift",
  "tag": "section",
  "class": "adora-routine-transformation-section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "VOM CHAOS ZUM RITUAL" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Von überladener Routine zu bewusstem Reset." },
    { "type": "richtext", "id": "subheadline", "label": "Subheadline", "default": "<p>ADORA reduziert deine Pflege auf das, was sich klar, vollständig und wiederholbar anfühlt.</p>" },
    { "type": "text", "id": "before_title", "label": "Before title", "default": "Vorher: Überladen" },
    { "type": "text", "id": "after_title", "label": "After title", "default": "Nachher: Reset" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "image_alt_before", "label": "Before image alt text", "default": "Überladene Skincare Routine" },
    { "type": "text", "id": "image_alt_after", "label": "After image alt text", "default": "ADORA Reset Ritual" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Ritual entdecken" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "background_style", "label": "Background style", "options": [{ "value": "cream", "label": "Cream" }, { "value": "mist", "label": "Mist" }, { "value": "lilac_gradient", "label": "Lilac gradient" }, { "value": "custom", "label": "Custom" }], "default": "cream" },
    { "type": "color_background", "id": "background_color", "label": "Custom background", "default": "linear-gradient(135deg, #fff8ef 0%, #fbf3ff 50%, #f4d8ff 100%)" },
    { "type": "color_background", "id": "before_panel_background", "label": "Before panel background", "default": "linear-gradient(180deg, rgba(247, 241, 236, 0.86), rgba(255, 255, 255, 0.7))" },
    { "type": "color_background", "id": "after_panel_background", "label": "After panel background", "default": "linear-gradient(135deg, rgba(251, 243, 255, 0.92), rgba(244, 216, 255, 0.72), rgba(255, 248, 239, 0.88))" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#3A2351" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#805394" },
    { "type": "range", "id": "padding_desktop", "label": "Padding desktop", "min": 48, "max": 180, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_mobile", "label": "Padding mobile", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
    { "type": "checkbox", "id": "show_center_marker", "label": "Show center marker", "default": true }
  ],
  "blocks": [
    {
      "type": "before_item",
      "name": "Before item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Zu viele Schritte" }
      ]
    },
    {
      "type": "after_item",
      "name": "After item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Drei bewusste Schritte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ADORA Routine Shift",
      "blocks": [
        { "type": "before_item", "settings": { "text": "Zu viele Schritte" } },
        { "type": "before_item", "settings": { "text": "Zu viele Produkte" } },
        { "type": "before_item", "settings": { "text": "Unklare Reihenfolge" } },
        { "type": "before_item", "settings": { "text": "Pflege fühlt sich wie Aufwand an" } },
        { "type": "after_item", "settings": { "text": "Drei bewusste Schritte" } },
        { "type": "after_item", "settings": { "text": "Klare Ritual-Logik" } },
        { "type": "after_item", "settings": { "text": "Weiches, gepflegtes Hautgefühl" } },
        { "type": "after_item", "settings": { "text": "Ein Moment, den du wiederholen willst" } }
      ]
    }
  ]
}
{% endschema %}
