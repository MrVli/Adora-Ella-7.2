{%- liquid
  assign benefit_cards = product.metafields.adora.benefit_cards.value
-%}

<section class="adora-pdp-benefits" style="--adora-pdp-accent: {{ section.settings.accent_color }}; --adora-pdp-text: {{ section.settings.text_color }}; --adora-pdp-bg: {{ section.settings.background_color }};">
  <div class="adora-pdp-benefits__inner">
    <div class="adora-pdp-benefits__header">
      {%- if section.settings.eyebrow != blank -%}<p>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.headline | escape }}</h2>
      {%- if section.settings.subheadline != blank -%}<div>{{ section.settings.subheadline }}</div>{%- endif -%}
    </div>
    <div class="adora-pdp-benefits__grid">
      {%- if benefit_cards != blank -%}
        {%- for card in benefit_cards limit: 6 -%}
          <article class="adora-pdp-benefits__card"><span>{{ forloop.index | prepend: '0' }}</span><h3>{{ card.title | default: card | escape }}</h3>{% if card.text != blank %}<p>{{ card.text | escape }}</p>{% endif %}</article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <article class="adora-pdp-benefits__card" {{ block.shopify_attributes }}><span>{{ forloop.index | prepend: '0' }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .adora-pdp-benefits { background: var(--adora-pdp-bg); color: var(--adora-pdp-text); padding: clamp(46px, 7vw, 108px) 16px; font-family: var(--font-body, Inter, sans-serif); }
  .adora-pdp-benefits__inner { width: min(100%, 1380px); margin: 0 auto; display: grid; gap: 26px; }
  .adora-pdp-benefits__header { max-width: 800px; }
  .adora-pdp-benefits__header p { margin: 0 0 10px; color: var(--adora-pdp-accent); font: 850 12px/1 var(--font-display, Inter, sans-serif); letter-spacing: .14em; text-transform: uppercase; }
  .adora-pdp-benefits__header h2 { margin: 0; font: 850 clamp(30px, 5vw, 58px)/.96 var(--font-display, Inter, sans-serif); letter-spacing: -.045em; }
  .adora-pdp-benefits__header div { margin-top: 14px; max-width: 620px; color: rgba(36,24,44,.68); line-height: 1.55; }
  .adora-pdp-benefits__grid { display: grid; gap: 14px; }
  .adora-pdp-benefits__card { min-height: 210px; border: 1px solid rgba(128,83,148,.15); border-radius: 28px; background: rgba(255,255,255,.78); box-shadow: 0 18px 60px rgba(58,35,81,.07); padding: clamp(20px, 3vw, 30px); }
  .adora-pdp-benefits__card span { display: inline-flex; margin-bottom: 34px; color: var(--adora-pdp-accent); font: 900 13px/1 var(--font-display, Inter, sans-serif); }
  .adora-pdp-benefits__card h3 { margin: 0; font: 850 clamp(20px, 2.2vw, 30px)/1 var(--font-display, Inter, sans-serif); letter-spacing: -.03em; }
  .adora-pdp-benefits__card p { margin: 12px 0 0; color: rgba(36,24,44,.68); line-height: 1.55; }
  @media (min-width: 750px) { .adora-pdp-benefits__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .adora-pdp-benefits__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

{% schema %}
{
  "name": "ADORA PDP Benefits",
  "tag": "section",
  "class": "section-adora-pdp-benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RITUAL BENEFITS" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Was sich verändert, wenn Pflege zum Ritual wird." },
    { "type": "richtext", "id": "subheadline", "label": "Subheadline", "default": "<p>Kurz, klar und hochwertig: Benefit-Karten für Vertrauen und Kaufentscheidung.</p>" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#24182c" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#805394" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Weiches Hautgefühl" }, { "type": "text", "id": "text", "label": "Text", "default": "Ein gepflegter, ruhiger Hautmoment ohne überladene Routine." } ] }
  ],
  "presets": [
    { "name": "ADORA PDP Benefits", "blocks": [ { "type": "benefit", "settings": { "title": "Haut wirkt gepflegter", "text": "Ein sichtbarer Pflege-Moment durch klare Ritual-Konsistenz." } }, { "type": "benefit", "settings": { "title": "Routine fühlt sich einfacher an", "text": "Weniger Entscheidungsstress, mehr bewusster Rhythmus." } }, { "type": "benefit", "settings": { "title": "Premium Ritual Experience", "text": "Ein Produktmoment, der hochwertig aussieht und sich so anfühlt." } } ] }
  ]
}
{% endschema %}
