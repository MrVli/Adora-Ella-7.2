{%- liquid
  assign header_menu = section.settings.menu
  assign trigger_label = section.settings.mega_trigger_label | default: 'Collections' | downcase
  assign cart_count = cart.item_count | default: 0
  assign is_homepage = false
  assign use_transparent = false
  assign mega_link = blank
  assign solid_logo = section.settings.logo_image
  assign transparent_logo = section.settings.transparent_logo_image

  if transparent_logo == blank
    assign transparent_logo = solid_logo
  endif

  if request.page_type == 'index'
    assign is_homepage = true
  endif

  if is_homepage and section.settings.enable_transparent_on_homepage
    assign use_transparent = true
  endif

  if header_menu != blank and header_menu.links.size > 0
    for link in header_menu.links
      assign link_title_downcase = link.title | downcase
      if link_title_downcase == trigger_label
        assign mega_link = link
      endif
    endfor
  endif

  assign has_mega_menu = false
  if mega_link != blank and mega_link.links.size > 0
    assign has_mega_menu = true
  endif
-%}

<header
  class="adora-mega-header adora-mega-header--drawer-{{ section.settings.mobile_drawer_position }}{% if use_transparent %} is-overlay is-transparent{% else %} is-scrolled{% endif %}"
  data-adora-mega-header
  data-sticky="{{ section.settings.enable_sticky }}"
  data-transparent-homepage="{{ section.settings.enable_transparent_on_homepage }}"
  data-page-type="{{ request.page_type }}"
  data-scroll-threshold="{{ section.settings.scroll_threshold }}"
  style="
    --adora-mega-header-bg: {{ section.settings.header_bg_color }};
    --adora-mega-header-text: {{ section.settings.header_text_color }};
    --adora-mega-header-transparent-text: {{ section.settings.transparent_text_color }};
    --adora-mega-header-accent: {{ section.settings.accent_color }};
    --adora-mega-header-border: {{ section.settings.border_color }};
    --adora-mega-header-menu-bg: {{ section.settings.mega_menu_bg_color }};
    --adora-mega-header-drawer-bg: {{ section.settings.drawer_bg_color }};
    --adora-mega-header-drawer-text: {{ section.settings.drawer_text_color }};
    --adora-mega-header-announcement-bg: {{ section.settings.announcement_bg_color }};
    --adora-mega-header-announcement-text: {{ section.settings.announcement_text_color }};
    --adora-mega-header-height-desktop: {{ section.settings.header_height_desktop }}px;
    --adora-mega-header-height: {{ section.settings.header_height_mobile }}px;
    --adora-mega-header-logo-desktop: {{ section.settings.logo_width_desktop }}px;
    --adora-mega-header-logo-mobile: {{ section.settings.logo_width_mobile }}px;
    --adora-mega-header-nav-size: {{ section.settings.nav_font_size }}px;
    --adora-mega-header-nav-spacing: {{ section.settings.nav_letter_spacing | divided_by: 100.0 }}em;
    --adora-announcement-speed: {{ section.settings.announcement_marquee_speed }}s;
  "
>
  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
    <div class="adora-mega-header__announcement adora-mega-header__announcement--{{ section.settings.announcement_mode }}{% if section.settings.announcement_pause_on_hover %} adora-mega-header__announcement--pause{% endif %}">
      {%- capture announcement_items -%}
        <span class="adora-mega-header__announcement-item">{{ section.settings.announcement_text | escape }}</span>
        <span class="adora-mega-header__announcement-item" aria-hidden="true">{{ section.settings.announcement_text | escape }}</span>
        <span class="adora-mega-header__announcement-item" aria-hidden="true">{{ section.settings.announcement_text | escape }}</span>
        <span class="adora-mega-header__announcement-item" aria-hidden="true">{{ section.settings.announcement_text | escape }}</span>
      {%- endcapture -%}
      {%- if section.settings.announcement_link != blank -%}
        <a class="adora-mega-header__announcement-track" href="{{ section.settings.announcement_link }}">{{ announcement_items }}</a>
      {%- else -%}
        <div class="adora-mega-header__announcement-track">{{ announcement_items }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="adora-mega-header__bar">
    <div class="adora-mega-header__mobile-left">
      <button class="adora-mega-header__icon-button" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="adora-mega-drawer-{{ section.id }}" data-adora-mega-drawer-open>
        <span class="adora-mega-header__burger-lines" aria-hidden="true"></span>
      </button>
    </div>

    <nav class="adora-mega-header__nav" aria-label="Hauptnavigation">
      {%- if header_menu != blank and header_menu.links.size > 0 -%}
        {%- for link in header_menu.links -%}
          {%- assign link_title_downcase = link.title | downcase -%}
          {%- if link_title_downcase == trigger_label and has_mega_menu -%}
            <button class="adora-mega-header__nav-button" type="button" aria-expanded="false" aria-controls="adora-mega-menu-{{ section.id }}" data-adora-mega-trigger>{{ link.title | escape }}</button>
          {%- else -%}
            <a class="adora-mega-header__nav-link" href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a class="adora-mega-header__nav-link" href="/">Home</a>
        <a class="adora-mega-header__nav-link" href="/collections/all">Collections</a>
        <a class="adora-mega-header__nav-link" href="/collections/all">Shop</a>
        <a class="adora-mega-header__nav-link" href="/blogs/news">Journal</a>
      {%- endif -%}
    </nav>

    <a class="adora-mega-header__logo" href="{{ routes.root_url }}" aria-label="{{ section.settings.logo_text | default: shop.name | escape }}">
      {%- if solid_logo != blank or transparent_logo != blank -%}
        <span class="adora-mega-header__logo-stack">
          {%- if solid_logo != blank -%}
            {{ solid_logo | image_url: width: 420 | image_tag: class: 'adora-mega-header__logo-image adora-mega-header__logo-image--solid', loading: 'eager', widths: '120, 180, 240, 320, 420', sizes: '(min-width: 990px) 180px, 44vw' }}
          {%- endif -%}
          {%- if transparent_logo != blank -%}
            {{ transparent_logo | image_url: width: 420 | image_tag: class: 'adora-mega-header__logo-image adora-mega-header__logo-image--transparent', loading: 'eager', widths: '120, 180, 240, 320, 420', sizes: '(min-width: 990px) 180px, 44vw' }}
          {%- endif -%}
        </span>
      {%- else -%}
        <span class="adora-mega-header__logo-text">{{ section.settings.logo_text | default: 'ADORA' | escape }}</span>
      {%- endif -%}
    </a>

    <div class="adora-mega-header__utilities" aria-label="Shop Links">
      {%- if section.settings.show_search -%}
        <a class="adora-mega-header__utility adora-mega-header__utility--icon" href="{{ routes.search_url }}" aria-label="{{ section.settings.search_label | escape }}">
          <svg class="adora-mega-header__svg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.show_account -%}
        <a class="adora-mega-header__utility adora-mega-header__utility--icon" href="{{ routes.account_url }}" aria-label="{{ section.settings.account_label | escape }}">
          <svg class="adora-mega-header__svg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 20c1.5-4 4-6 7.5-6s6 2 7.5 6"></path></svg>
        </a>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'utility_link' and block.settings.show_desktop and block.settings.label != blank -%}
          <a class="adora-mega-header__utility" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.show_cart -%}
        <a class="adora-mega-header__utility adora-mega-header__utility--icon adora-mega-header__utility--cart" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | escape }}{% if section.settings.show_cart_count %}: {{ cart_count }}{% endif %}">
          <svg class="adora-mega-header__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9h10l-.8 10H7.8L7 9Z"></path><path d="M9 9a3 3 0 0 1 6 0"></path></svg>
          {%- if section.settings.show_cart_count -%}<span class="adora-mega-header__cart-count">{{ cart_count }}</span>{%- endif -%}
        </a>
      {%- endif -%}
    </div>

    <div class="adora-mega-header__mobile-right">
      {%- if section.settings.show_cart -%}
        <a class="adora-mega-header__icon-button adora-mega-header__icon-button--cart" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | escape }}{% if section.settings.show_cart_count %}: {{ cart_count }}{% endif %}">
          <svg class="adora-mega-header__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9h10l-.8 10H7.8L7 9Z"></path><path d="M9 9a3 3 0 0 1 6 0"></path></svg>
          {%- if section.settings.show_cart_count -%}<span class="adora-mega-header__cart-count">{{ cart_count }}</span>{%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if has_mega_menu -%}
    <div class="adora-mega-header__mega" id="adora-mega-menu-{{ section.id }}" aria-hidden="true" data-adora-mega-menu>
      <div class="adora-mega-header__mega-inner" data-adora-mega-tab-scope>
        <div class="adora-mega-header__mega-layout">
          <div class="adora-mega-header__mega-left">
            <div class="adora-mega-header__category-grid" role="tablist" aria-label="Collections Kategorien">
              {%- for category_link in mega_link.links limit: 6 -%}
                {%- liquid
                  assign tab_key = category_link.title | handleize
                  assign category_object = category_link.object
                  assign category_image = blank
                  if category_object.featured_image != blank
                    assign category_image = category_object.featured_image
                  elsif category_object.image != blank
                    assign category_image = category_object.image
                  endif
                  if category_image == blank and category_link.links.size > 0
                    for child_link in category_link.links limit: 1
                      assign child_object = child_link.object
                      if child_object.featured_image != blank
                        assign category_image = child_object.featured_image
                      elsif child_object.image != blank
                        assign category_image = child_object.image
                      endif
                    endfor
                  endif
                -%}
                <a class="adora-mega-header__category-tile" href="{{ category_link.url | default: '#' }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-adora-mega-tab="{{ tab_key }}">
                  <span class="adora-mega-header__category-media">
                    {%- if category_image != blank -%}
                      {{ category_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 280, 420', sizes: '14vw', alt: category_link.title }}
                    {%- else -%}
                      <span class="adora-mega-header__product-placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                  </span>
                  <span class="adora-mega-header__category-title">{{ category_link.title | escape }}</span>
                </a>
              {%- endfor -%}
            </div>

            <a class="adora-mega-header__latest-link" href="{{ section.settings.latest_link_url | default: mega_link.url | default: '#' }}">
              <span>{{ section.settings.latest_link_label | escape }}</span>
              <svg class="adora-mega-header__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15"></path><path d="m13 5 7 7-7 7"></path></svg>
            </a>
          </div>

          <div class="adora-mega-header__promo-panels">
            {%- for category_link in mega_link.links limit: 6 -%}
              {%- assign panel_key = category_link.title | handleize -%}
              <div class="adora-mega-header__panel{% if forloop.first %} is-active{% endif %}" data-adora-mega-panel="{{ panel_key }}">
                <div class="adora-mega-header__promo-grid">
                  {%- liquid
                    assign primary_link = category_link
                    if category_link.links.size > 0
                      assign primary_link = category_link.links.first
                    endif
                    assign linked_object = primary_link.object
                    assign card_title = primary_link.title
                    assign card_url = primary_link.url | default: '#'
                    assign card_image = blank
                    assign card_text = category_link.title
                    if linked_object.featured_image != blank
                      assign card_image = linked_object.featured_image
                    elsif linked_object.image != blank
                      assign card_image = linked_object.image
                    endif
                    if linked_object.type != blank
                      assign card_text = linked_object.type
                    elsif linked_object.vendor != blank
                      assign card_text = linked_object.vendor
                    endif
                    assign banner_link = section.settings.mega_banner_link | default: mega_link.url | default: '#'
                  -%}
                  <a class="adora-mega-header__promo-card" href="{{ card_url }}">
                    {%- if card_image != blank -%}
                      {{ card_image | image_url: width: 780 | image_tag: class: 'adora-mega-header__promo-image', loading: 'lazy', widths: '360, 520, 780', sizes: '26vw', alt: card_title }}
                    {%- else -%}
                      <span class="adora-mega-header__promo-image adora-mega-header__product-placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                    <span class="adora-mega-header__promo-shade" aria-hidden="true"></span>
                    {%- if section.settings.promo_badge != blank -%}<span class="adora-mega-header__promo-badge">{{ section.settings.promo_badge | escape }}</span>{%- endif -%}
                    <span class="adora-mega-header__promo-content">
                      <strong class="adora-mega-header__promo-title">{{ card_title | escape }}</strong>
                      <span class="adora-mega-header__promo-text">{{ card_text | escape }}</span>
                    </span>
                    <svg class="adora-mega-header__promo-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15"></path><path d="m13 5 7 7-7 7"></path></svg>
                  </a>

                  <a class="adora-mega-header__promo-card adora-mega-header__promo-card--banner" href="{{ banner_link }}">
                    {%- if section.settings.mega_banner_image != blank -%}
                      {{ section.settings.mega_banner_image | image_url: width: 780 | image_tag: class: 'adora-mega-header__promo-image', loading: 'lazy', widths: '360, 520, 780', sizes: '26vw', alt: section.settings.mega_banner_heading }}
                    {%- else -%}
                      <span class="adora-mega-header__promo-image adora-mega-header__product-placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                    <span class="adora-mega-header__promo-shade" aria-hidden="true"></span>
                    {%- if section.settings.mega_banner_badge != blank -%}<span class="adora-mega-header__promo-badge">{{ section.settings.mega_banner_badge | escape }}</span>{%- endif -%}
                    <span class="adora-mega-header__promo-content">
                      <strong class="adora-mega-header__promo-title">{{ section.settings.mega_banner_heading | escape }}</strong>
                      <span class="adora-mega-header__promo-text">{{ section.settings.mega_banner_text | escape }}</span>
                    </span>
                    <svg class="adora-mega-header__promo-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15"></path><path d="m13 5 7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="adora-mega-header__drawer-overlay" data-adora-mega-drawer-overlay></div>
  <aside class="adora-mega-header__drawer" id="adora-mega-drawer-{{ section.id }}" aria-hidden="true" data-adora-mega-drawer>
    <div class="adora-mega-header__drawer-head">
      <a class="adora-mega-header__drawer-logo" href="{{ routes.root_url }}">
        {%- if solid_logo != blank -%}
          {{ solid_logo | image_url: width: 320 | image_tag: class: 'adora-mega-header__drawer-logo-image', loading: 'eager', widths: '120, 180, 240, 320', sizes: '132px' }}
        {%- else -%}
          {{ section.settings.logo_text | default: 'ADORA' | escape }}
        {%- endif -%}
      </a>
      <button class="adora-mega-header__icon-button" type="button" aria-label="Menü schließen" data-adora-mega-drawer-close>
        <svg class="adora-mega-header__svg" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12"></path><path d="M18 6 6 18"></path></svg>
      </button>
    </div>
    <div class="adora-mega-header__drawer-scroll">
      <nav class="adora-mega-header__drawer-nav" aria-label="Mobile Navigation">
        {%- if header_menu != blank and header_menu.links.size > 0 -%}
          {%- for link in header_menu.links -%}
            {%- assign link_title_downcase = link.title | downcase -%}
            {%- if link_title_downcase == trigger_label and has_mega_menu -%}
              <details class="adora-mega-header__drawer-details" open>
                <summary class="adora-mega-header__drawer-summary">{{ link.title | escape }}<span class="adora-mega-header__drawer-plus" aria-hidden="true"></span></summary>
                <div class="adora-mega-header__mobile-mega" data-adora-mega-tab-scope>
                  <div class="adora-mega-header__mobile-category-tabs" role="tablist" aria-label="Mobile Collections Kategorien">
                    {%- for category_link in mega_link.links limit: 6 -%}
                      {%- assign mobile_tab_key = category_link.title | handleize -%}
                      <button class="adora-mega-header__mobile-category-tab" type="button" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-adora-mega-tab="mobile-{{ mobile_tab_key }}">{{ category_link.title | escape }}</button>
                    {%- endfor -%}
                  </div>
                  {%- for category_link in mega_link.links limit: 6 -%}
                    {%- assign mobile_panel_key = category_link.title | handleize -%}
                    <div class="adora-mega-header__mobile-panel{% if forloop.first %} is-active{% endif %}" data-adora-mega-panel="mobile-{{ mobile_panel_key }}">
                      <a class="adora-mega-header__mobile-view-all" href="{{ category_link.url | default: '#' }}">
                        <span>{{ category_link.title | escape }}</span>
                        <svg class="adora-mega-header__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15"></path><path d="m13 5 7 7-7 7"></path></svg>
                      </a>
                      <div class="adora-mega-header__mobile-products">
                        {%- if category_link.links.size > 0 -%}
                          {%- for product_link in category_link.links limit: 4 -%}
                            {%- liquid
                              assign mobile_object = product_link.object
                              assign mobile_title = product_link.title
                              assign mobile_url = product_link.url | default: '#'
                              assign mobile_image = blank
                              assign mobile_text = category_link.title
                              if mobile_object.featured_image != blank
                                assign mobile_image = mobile_object.featured_image
                              elsif mobile_object.image != blank
                                assign mobile_image = mobile_object.image
                              endif
                              if mobile_object.type != blank
                                assign mobile_text = mobile_object.type
                              elsif mobile_object.vendor != blank
                                assign mobile_text = mobile_object.vendor
                              endif
                            -%}
                            <a class="adora-mega-header__mobile-product" href="{{ mobile_url }}">
                              <span class="adora-mega-header__mobile-product-media">
                                {%- if mobile_image != blank -%}
                                  {{ mobile_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '92px', alt: mobile_title }}
                                {%- else -%}
                                  <span class="adora-mega-header__product-placeholder" aria-hidden="true"></span>
                                {%- endif -%}
                              </span>
                              <span class="adora-mega-header__mobile-product-copy"><strong class="adora-mega-header__mobile-product-title">{{ mobile_title | escape }}</strong><span class="adora-mega-header__mobile-product-text">{{ mobile_text | escape }}</span></span>
                            </a>
                          {%- endfor -%}
                        {%- else -%}
                          <a class="adora-mega-header__mobile-product" href="{{ category_link.url | default: '#' }}">
                            <span class="adora-mega-header__mobile-product-media"><span class="adora-mega-header__product-placeholder" aria-hidden="true"></span></span>
                            <span class="adora-mega-header__mobile-product-copy"><strong class="adora-mega-header__mobile-product-title">{{ category_link.title | escape }}</strong><span class="adora-mega-header__mobile-product-text">{{ section.settings.collection_card_text | escape }}</span></span>
                          </a>
                        {%- endif -%}
                      </div>
                      {%- if section.settings.show_mobile_banner -%}
                        <a class="adora-mega-header__mobile-banner" href="{{ section.settings.mega_banner_link | default: mega_link.url | default: '#' }}">
                          {%- if section.settings.mega_banner_image != blank -%}
                            {{ section.settings.mega_banner_image | image_url: width: 620 | image_tag: class: 'adora-mega-header__mobile-banner-image', loading: 'lazy', widths: '320, 480, 620', sizes: '86vw', alt: section.settings.mega_banner_heading }}
                          {%- else -%}
                            <span class="adora-mega-header__mobile-banner-image adora-mega-header__product-placeholder" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="adora-mega-header__promo-shade" aria-hidden="true"></span>
                          <span class="adora-mega-header__mobile-banner-content"><strong>{{ section.settings.mega_banner_heading | escape }}</strong><span>{{ section.settings.mega_banner_text | escape }}</span></span>
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </details>
            {%- else -%}
              <a class="adora-mega-header__drawer-link" href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <a class="adora-mega-header__drawer-link" href="/">Home</a>
          <a class="adora-mega-header__drawer-link" href="/collections/all">Collections</a>
          <a class="adora-mega-header__drawer-link" href="/blogs/news">Journal</a>
        {%- endif -%}
        {%- if section.settings.show_search -%}<a class="adora-mega-header__drawer-link" href="{{ routes.search_url }}">{{ section.settings.search_label | escape }}</a>{%- endif -%}
        {%- if section.settings.show_account -%}<a class="adora-mega-header__drawer-link" href="{{ routes.account_url }}">{{ section.settings.account_label | escape }}</a>{%- endif -%}
      </nav>
      {%- if section.settings.mobile_promo_text != blank -%}
        <div class="adora-mega-header__drawer-promo"><p>{{ section.settings.mobile_promo_text | escape }}</p></div>
      {%- endif -%}
    </div>
  </aside>
</header>

{% schema %}
{
  "name": "ADORA Mega Header",
  "tag": "section",
  "class": "adora-mega-header-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "enable_sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "enable_transparent_on_homepage", "label": "Transparent over homepage hero", "default": true },
    { "type": "range", "id": "scroll_threshold", "label": "White background after scroll", "min": 0, "max": 180, "step": 5, "unit": "px", "default": 20 },
    { "type": "link_list", "id": "menu", "label": "Main menu" },
    { "type": "text", "id": "mega_trigger_label", "label": "Mega menu trigger label", "default": "Collections" },
    { "type": "image_picker", "id": "transparent_logo_image", "label": "Logo image transparent header" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image solid header" },
    { "type": "text", "id": "logo_text", "label": "Logo text fallback", "default": "ADORA" },
    { "type": "range", "id": "logo_width_desktop", "label": "Logo width desktop", "min": 80, "max": 260, "step": 4, "unit": "px", "default": 148 },
