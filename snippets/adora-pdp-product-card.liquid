{%- liquid
  assign card_product = product_card
  assign card_variant = card_product.selected_or_first_available_variant
-%}

{%- if card_product != blank -%}
  <article class="adora-pdp-product-card">
    <a class="adora-pdp-product-card__image-link" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_image != blank -%}
        {{ card_product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', class: 'adora-pdp-product-card__image', alt: card_product.title }}
      {%- else -%}
        <div class="adora-pdp-product-card__placeholder" aria-hidden="true">ADORA</div>
      {%- endif -%}
    </a>
    <div class="adora-pdp-product-card__content">
      <p class="adora-pdp-product-card__role">Ritual pairing</p>
      <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      <p class="adora-pdp-product-card__price">{{ card_product.price | money }}</p>
      {%- form 'product', card_product, class: 'adora-pdp-product-card__form' -%}
        <input type="hidden" name="id" value="{{ card_variant.id }}">
        <button type="submit" {% unless card_variant.available %}disabled{% endunless %}>Add to ritual</button>
      {%- endform -%}
    </div>
  </article>
{%- endif -%}
